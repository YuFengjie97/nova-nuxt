void mainImage(out vec4 O, in vec2 I){
  vec2 R = iResolution.xy;
  vec2 uv = (I*2.-R)/R.y;
  vec2 uv2 = I/R;
  uv.y = -uv.y;
  uv.x += .5;
  uv.y -=.2;

  O.rgb *= 0.;
  O.a = 1.;

  vec3 col = vec3(0);
  
  if(iFrame<4){
    float d = char(uv);
    d = smoothstep(.03,0.0,d);
    // col += pow(.02/d, 1.)*mix(vec3(0.216,1.000,0.000), vec3(0.000,0.424,0.980),uv.y+.4);
    O.rgb += d;
  }else{
    O.rgb = texture(iChannel0, uv2).rgb;
  }
}